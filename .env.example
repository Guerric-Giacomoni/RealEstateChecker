# --- Listing scraper (Apify) -------------------------------------------------
# The /api/scrape route runs ready-made Apify actors that return structured
# listing data, so we don't fetch HTML or fight DataDome ourselves.
#
#   Leboncoin → scrapifier/leboncoin-universal-scraper (third-party)
#   SeLoger   → enheartening_scorecard/seloger-listing-scraper (our own actor)
#
# Get a token at https://console.apify.com/account/integrations, then set it
# here. Copy this file to `.env.local` and fill it in (never commit .env.local).
APIFY_TOKEN=

# Optional — override the actor IDs if they ever change (use ~ or /):
# APIFY_LEBONCOIN_ACTOR=scrapifier~leboncoin-universal-scraper
# APIFY_SELOGER_ACTOR=enheartening_scorecard~seloger-listing-scraper

# --- DVF database (Turso) ----------------------------------------------------
# Hosted SQLite for the "Ventes comparables" (DVF) data. Create a DB from the
# local file (`turso db create dvf --from-file data/dvf-2025.sqlite`), then:
#   turso db show <db> --url         → TURSO_DATABASE_URL
#   turso db tokens create <db>      → TURSO_AUTH_TOKEN
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
